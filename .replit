# Replit configuration. Run with the "Run" button (python main.py).
modules = ["python-3.11"]
run = "python main.py"
entrypoint = "main.py"

# ffmpeg (includes ffprobe) as a system dependency: the real binary,
# not the "ffmpeg" pip package.
[nix]
channel = "stable-24_05"
packages = ["ffmpeg"]

[[ports]]
localPort = 5000
externalPort = 80

# Use a Reserved VM deployment: download jobs live in memory, so the app
# must run as ONE always-on process (Autoscale would lose them).
[deployment]
deploymentTarget = "gce"
run = ["python", "main.py"]
